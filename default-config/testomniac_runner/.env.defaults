# Default environment variables for testomniac_runner
# Non-sensitive values only - secrets come from Doppler

# Server
PORT=8030
LOG_LEVEL=info

# Polling & concurrency
SCAN_POLL_INTERVAL_MS=10000
MAX_CONCURRENT_RUNNERS=5

# Browser
CHROMIUM_PATH=/usr/bin/chromium
USER_DATA_DIR=/app/testomniac-browser-profile
ARTIFACT_DIR=/app/testomniac-artifacts

# Email reports
APP_BASE_URL=https://app.testomniac.com

# Signic email verification
SIGNIC_INDEXER_URL=https://api.signic.email/idx
SIGNIC_EMAIL_API_URL=https://api.signic.email/api

# =============================================================================
# REQUIRED SECRETS (must be set via Doppler)
# =============================================================================
# TESTOMNIAC_API_URL=https://api.testomniac.com
# SCANNER_API_KEY=<shared secret, must match testomniac_api>

# =============================================================================
# OPTIONAL SECRETS (set via Doppler if needed)
# =============================================================================
# POSTMARK_SERVER_TOKEN=<postmark API token>
# POSTMARK_FROM_EMAIL=<sender email address>
# DEEP_LINK_SECRET=<JWT signing secret for report deep links>
